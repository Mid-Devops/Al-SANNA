{
  "name": "alsanna-next",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-standalone-assets.js",
    "start": "node .next/standalone/server.js",
    "format": "prettier --write \"**/*.{html,css,js,jsx,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,jsx,mjs,json,md}\"",
    "validate:html": "html-validate \"*.html\""
  },
  "devDependencies": {
    "html-validate": "^11.18.0",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
